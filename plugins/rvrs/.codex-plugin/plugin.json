{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rvrs",
  "version": "0.17.0",
  "description": "Network diagnostics for agents with the rvrs CLI: ping, traceroute, MTR, dig for DNS, and BGP lookups with ASN and RPKI. Every run is a JSON report, compared with the history rvrs keeps, so an agent can say what changed and name the runs that show it.",
  "author": {
    "name": "rvrs",
    "url": "https://rvrs.dev"
  },
  "homepage": "https://rvrs.dev/ai-agent-network-diagnostics-skill",
  "repository": "https://github.com/rvrs-dev/cli",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "networking",
    "network-diagnostics",
    "network-troubleshooting",
    "network-tools",
    "ping",
    "traceroute",
    "mtr",
    "dig",
    "dns",
    "bgp",
    "asn",
    "rpki",
    "latency",
    "packet-loss",
    "ipv6",
    "connectivity",
    "looking-glass",
    "sysadmin",
    "devops",
    "sre"
  ]
}
